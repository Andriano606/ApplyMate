= header(**header_opts)

- if signed_in?
  / The one [user, vacancy] subscription: the action box and the applies panel ride it (no status badge here).
  = Apply::TurboHandler::StatusUpdate.stream_from(@vacancy, current_user, helpers)

div(class=GRID_CLASSES)
  / Summary
  div(class=SUMMARY_CLASSES)
    .flex.items-center.gap-4
      = render Vacancy::Component::CompanyLogo.new(vacancy: @vacancy, size: :lg)
      / The lg logo (50px) is as tall as these two lines: name (24px) + mt-1 + badge row (22px)
      .min-w-0.flex-1
        - if @vacancy.company_name.present?
          p.truncate.text-base.font-semibold.text-gray-900.dark:text-gray-100 = @vacancy.company_name
        .mt-1.flex.flex-wrap.items-center.gap-x-3.gap-y-2.text-xs.text-gray-500.dark:text-gray-400
          span.sr-only = I18n.t('vacancy.show.source')
          = badge(label: @vacancy.source.name, color: :green)
          span.inline-flex.items-center.gap-1
            = icon(:clock, size: 4)
            = added_on

  / Sidebar: second on phones so the apply call to action is reachable without scrolling past the description
  div(class=SIDEBAR_CLASSES)
    = render Vacancy::Component::ActionCard.new(vacancy: @vacancy)

  / Main column
  .min-w-0.space-y-4.sm:space-y-6.lg:col-span-2
    = render Vacancy::Component::Section.new(id: 'vacancy-description', icon: :info_circle, \
        title: I18n.t('vacancy.show.sections.description')) do
      - if @vacancy.description_present?
        / Rendered in full rather than clamped: reading it is the point of this page
        div *data_test_id('vacancy-description')
          = rich_text(html: @vacancy.description_html, text: @vacancy.description)
      - else
        p.text-sm.italic.text-gray-400.dark:text-gray-500 = I18n.t('vacancy.show.no_description')

    - if signed_in?
      = render Vacancy::Component::Section.new(id: 'vacancy-applies', title: I18n.t('vacancy.show.sections.applies'), \
          icon: :send, data: ANCHOR_SCROLL) do |section|
        - section.with_header_action do
          = link(url: helpers.applies_path, label: I18n.t('vacancy.show.all_applies'), size: :sm)
        = Apply::TurboHandler::VacancyIndex.frame_tag(@vacancy, current_user, helpers, \
            src: helpers.vacancy_applies_path(@vacancy)) do
          = render Vacancy::Component::SectionSkeleton.new

      = render Vacancy::Component::Section.new(id: 'vacancy-cvs', title: I18n.t('vacancy.show.sections.cvs'), \
          icon: :document_text, data: ANCHOR_SCROLL) do |section|
        - section.with_header_action do
          = link(url: helpers.new_vacancy_vacancy_cv_path(@vacancy), variant: :outline, size: :sm, \
              class: 'gap-1', data: { turbo_stream: true }) do
            = icon(:sparkles, size: 4)
            = I18n.t('vacancy.show.generate_cv')
        = VacancyCv::TurboHandler::Index.frame_tag(@vacancy, helpers, \
            src: helpers.vacancy_vacancy_cvs_path(@vacancy)) do
          = render Vacancy::Component::SectionSkeleton.new

      = render Vacancy::Component::Section.new(id: 'vacancy-questions', icon: :chat_bubble, \
          title: I18n.t('vacancy.show.sections.questions')) do |section|
        - section.with_header_action do
          = link(url: helpers.new_vacancy_vacancy_question_path(@vacancy), variant: :outline, size: :sm, \
              class: 'gap-1', data: { turbo_stream: true }) do
            = icon(:chat_bubble, size: 4)
            = I18n.t('vacancy_question.ask')
        = VacancyQuestion::TurboHandler::Index.frame_tag(@vacancy, helpers, \
            src: helpers.vacancy_vacancy_questions_path(@vacancy)) do
          = render Vacancy::Component::SectionSkeleton.new(rows: 1)
