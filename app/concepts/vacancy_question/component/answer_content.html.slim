/ block: an inline <turbo-frame> would ignore the list's space-y gap between answers
= VacancyQuestion::TurboHandler::AnswerReady.frame_tag(@vacancy_question, helpers, class: 'block') do
  article.rounded-xl.border.border-gray-200.bg-white.p-4.dark:border-gray-700.dark:bg-gray-800.sm:p-5
    .flex.items-start.gap-3
      span(class=[ 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full',
                   'bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400' ] aria-hidden='true')
        = icon(:chat_bubble, size: 4)
      .min-w-0.flex-1
        h3.text-sm.font-semibold.leading-snug.text-gray-900.dark:text-gray-100.whitespace-pre-line.break-words
          = @vacancy_question.question
        time.mt-1.block.text-xs.text-gray-500.dark:text-gray-400 datetime=@vacancy_question.created_at.iso8601
          = I18n.l(@vacancy_question.created_at, format: :short)

    .mt-4
      - if answered?
        = tabs(base_url: helpers.vacancy_vacancy_questions_path(@vacancy), \
            id: "tabs_vacancy_question_#{@vacancy_question.hashid}") do |t|
          - t.with_tab(label: I18n.t('vacancy_question.tab_answer')) do
            div(class='rounded-lg border border-gray-100 bg-gray-50 dark:border-gray-700 dark:bg-gray-900/40' \
              data-controller='clipboard')
              .flex.justify-end.px-2.pt-2
                = button(variant: :icon, size: :sm, class: 'gap-1', title: I18n.t('vacancy_question.copy'), \
                    aria: { label: I18n.t('vacancy_question.copy') }, \
                    data: { clipboard_target: 'button', action: 'click->clipboard#copy' }) do
                  = icon(:clipboard_list, size: 4)
                  span.hidden.sm:inline = I18n.t('vacancy_question.copy')
              .px-3.pb-3.text-sm.leading-relaxed.text-gray-800.dark:text-gray-200.whitespace-pre-wrap.break-words [
                data-clipboard-target='source'
                ]
                = @vacancy_question.answer
          - t.with_tab(label: I18n.t('vacancy_question.tab_prompt')) do
            .text-sm.text-gray-600.dark:text-gray-400.whitespace-pre-wrap.break-words.font-mono.leading-relaxed
              = VacancyQuestion::Ai::Prompt::AnswerQuestion.call(@vacancy_question)
      - else
        .flex.items-center.gap-2.text-sm.text-gray-500.dark:text-gray-400
          span(class=[ 'inline-block h-3.5 w-3.5 animate-spin rounded-full border-2',
                       'border-gray-200 border-t-indigo-500 dark:border-gray-600' ] aria-hidden='true')
          = I18n.t('vacancy_question.generating')
