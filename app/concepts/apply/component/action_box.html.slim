= Apply::TurboHandler::ActionBox.frame_tag(@vacancy, @user, helpers) do
  .space-y-3 *data_test_id('apply-action-box')
    - case state
    - when :none
      div
        p.text-sm.font-semibold.text-gray-900.dark:text-gray-100 = I18n.t('apply.action_box.ready_title')
        p.mt-1.text-xs.leading-relaxed.text-gray-500.dark:text-gray-400 = I18n.t('apply.action_box.ready_hint')
      = link(url: new_apply_path, variant: :primary, class: 'w-full justify-center gap-2', \
          data: { turbo_stream: true }) do
        = icon(:send, size: 4)
        = I18n.t('apply.action_box.apply')

    - when :in_progress
      = render Apply::Component::StatusPill.new(apply: @apply)
      p.text-xs.leading-relaxed.text-gray-500.dark:text-gray-400 = I18n.t('apply.action_box.in_progress_hint')
      = link(url: '#vacancy-applies', variant: :outline, class: 'w-full gap-2', data: { turbo: false }) do
        = icon(:arrow_right, size: 4)
        = I18n.t('apply.action_box.view_progress')

    - when :completed
      div(class='flex items-start gap-3 rounded-lg bg-green-50 p-3 dark:bg-green-900/20')
        = icon(:check_circle, size: 5, class: 'shrink-0 text-green-600 dark:text-green-400')
        div
          p.text-sm.font-semibold.text-green-800.dark:text-green-300 = I18n.t('apply.action_box.completed')
          p.mt-1.text-xs.text-green-700.dark:text-green-400
            = I18n.l(@apply.created_at, format: :short)
      = link(url: new_apply_path, variant: :outline, class: 'w-full gap-2', data: { turbo_stream: true }) do
        = icon(:send, size: 4)
        = I18n.t('apply.action_box.apply_again')

    - when :failed
      = render Apply::Component::StatusPill.new(apply: @apply)
      p.text-xs.leading-relaxed.text-gray-500.dark:text-gray-400 = I18n.t('apply.action_box.failed_hint')
      = link(url: new_apply_path, variant: :primary, class: 'w-full justify-center gap-2', \
          data: { turbo_stream: true }) do
        = icon(:refresh, size: 4)
        = I18n.t('apply.action_box.retry')
