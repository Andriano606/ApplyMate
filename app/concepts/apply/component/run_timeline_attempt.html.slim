ol.space-y-2
  - @steps.each do |step|
    li(class='grid grid-cols-[1rem_1fr] items-start gap-x-2 gap-y-0.5 text-sm sm:grid-cols-[1rem_1fr_auto] sm:gap-x-3' \
        data-step-state=step.state)
      span.mt-0.5.shrink-0
        - if step.running?
          span(class='inline-block h-4 w-4 animate-spin rounded-full border-2 border-yellow-500 border-t-transparent' \
              aria-hidden='true')
        - else
          = icon(icon_config(step)[:icon], size: 4, class: icon_config(step)[:color])
      span.min-w-0.font-medium.text-gray-800.dark:text-gray-200 = I18n.t("apply.stage.#{step.stage}")
      - if duration_label(step)
        span.col-start-2.text-xs.text-gray-500.dark:text-gray-400.sm:col-start-3.sm:row-start-1 = duration_label(step)
      - if error_title(step)
        p.col-start-2.text-xs.text-red-700.dark:text-red-300 = error_title(step)
      - if error_detail(step)
        pre(class=[ 'col-start-2 max-h-32 overflow-auto whitespace-pre-wrap break-words font-mono text-xs',
                    'text-gray-600 dark:text-gray-400' ]) = error_detail(step)
      - if step.artifacts_attachments.any?
        ul.col-start-2.flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-xs
          li.text-gray-500.dark:text-gray-400 = I18n.t('apply.run_timeline.artifacts')
          - artifact_links(step).each do |name, path|
            li
              = link_to name, path, target: '_blank', rel: 'noopener',
                  class: 'text-blue-600 hover:underline dark:text-blue-400'
