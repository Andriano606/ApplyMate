= turbo_form_modal( \
    model: @apply, \
    endpoint: @apply, \
    header_text: I18n.t('apply.new.title'), \
    submit_text: I18n.t('apply.new.submit')) do |modal|

  = modal.form.hidden_field :vacancy_id

  .space-y-4
    = modal.form.input :source_profile_id, \
        as: :select, \
        wrapper: :select, \
        collection: current_user.source_profiles.includes(:source).where(source_id: @apply.vacancy&.source_id), \
        label_method: proc { |sp| "#{sp.source.name} (#{sp.name})" }, \
        value_method: :id, \
        include_blank: I18n.t('apply.new.form.select_source_profile'), \
        label: I18n.t('apply.new.form.source_profile', source_name: @apply.vacancy&.source.name), \
        with_new_link: { \
          link: helpers.link_to(I18n.t('source_profile.new_link'),
                  helpers.new_source_profile_path(source_profile: { source_id: @apply.vacancy&.source_id }),
                  class: 'text-blue-600 underline hover:text-blue-700', data: { turbo_stream: true }), \
          option_component: 'SourceProfile::Component::SelectOption' \
        }

    = render Vacancy::Component::GenerateCvForm.new(form: modal.form)

    = modal.form.input :fill_form_prompt_id, \
        as: :select, \
        wrapper: :select, \
        collection: current_user.prompts.fill_form, \
        label_method: :name, \
        value_method: :id, \
        include_blank: I18n.t('apply.new.form.select_fill_form_prompt'), \
        label: I18n.t('apply.new.form.fill_form_prompt')

    - if reapply_guarded?
      div(class=[ 'space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-3',
                  'dark:border-amber-900/50 dark:bg-amber-900/20' ] role='alert')
        p.text-sm.text-amber-800.dark:text-amber-300 = I18n.t('apply.new.form.reapply_notice')
        = modal.form.input :confirm_reapply, as: :boolean, label: I18n.t('apply.new.form.confirm_reapply')
