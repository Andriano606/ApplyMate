= header(**header_opts)
= Apply::TurboHandler::StatusUpdate.stream_from(@apply.vacancy, current_user, helpers)

= render Apply::Component::InfoCard.new(apply: @apply)

/ ─── Content Sections ────────────────────────────────────────────────────────
.space-y-3
  / CV
  = accordion(title: I18n.t('apply.show.fields.cv')) do |a|
    - if @apply.cv.attached?
      - a.with_actions do
        = link(url: helpers.rails_blob_path(@apply.cv, disposition: 'attachment'), size: :md) do
          = I18n.t('apply.show.download_cv')
      .px-6.py-4
        = tabs(base_url: helpers.apply_path(@apply)) do |t|
          - t.with_tab(label: I18n.t('apply.show.cv_tab_preview')) do
            iframe.w-full.rounded-lg.border.border-gray-200.dark:border-gray-700(
              src="#{helpers.rails_blob_path(@apply.cv, disposition: 'inline')}#toolbar=0"
              style='height:600px'
            )
          - t.with_tab(label: I18n.t('apply.show.cv_tab_prompt')) do
            .text-sm.text-gray-600.dark:text-gray-400.whitespace-pre-wrap.font-mono.leading-relaxed
              = Apply::Ai::Prompt::GenerateCv.call(user_profile: @apply.user_profile, \
                  vacancy: @apply.vacancy, generate_cv_prompt: @apply.generate_cv_prompt)
    - else
      .px-6.py-4
        p.mt-2.text-sm.text-gray-400.dark:text-gray-500.italic = I18n.t('apply.show.no_data')

  / Screenshot
  - if @apply.screenshot.attached?
    = accordion(title: I18n.t('apply.show.fields.screenshot')) do
      .px-6.py-4
        = helpers.link_to helpers.rails_blob_path(@apply.screenshot, disposition: 'inline'), \
                target: '_blank', rel: 'noopener noreferrer' do
          = helpers.image_tag( \
              helpers.rails_blob_path(@apply.screenshot, disposition: 'inline'), \
              class: 'w-full rounded-lg border border-gray-200 dark:border-gray-600 ' \
                     'shadow-sm hover:opacity-90 transition-opacity', \
              alt: I18n.t('apply.show.fields.screenshot') \
            )

  / Filled form data
  = accordion(title: I18n.t('apply.show.filled_form_data')) do
    - if @apply.filled_inputs.present?
      .px-6.py-4
        = tabs(base_url: helpers.apply_path(@apply)) do |t|
          - t.with_tab(label: I18n.t('apply.show.filled_form_tab_fields')) do
            = render Apply::Component::FilledFormPreview.new(filled_inputs: @apply.filled_inputs)
          - t.with_tab(label: I18n.t('apply.show.cv_tab_prompt')) do
            .text-sm.text-gray-600.dark:text-gray-400.whitespace-pre-wrap.font-mono.leading-relaxed
              = Apply::Ai::Prompt::FillForm.call(@apply, @apply.inputs)
    - else
      .px-6.py-4
        p.mt-2.text-sm.text-gray-400.dark:text-gray-500.italic = I18n.t('apply.show.no_data')

  / Submit from your own browser — for sites that refuse automated ones
  - if manual_answers.any?
    = accordion(title: I18n.t('apply.manual.title'), open: @apply.needs_review?) do
      .px-6.py-4.space-y-4
        p.text-sm.text-gray-600.dark:text-gray-400 = I18n.t('apply.manual.hint')
        .flex.flex-wrap.items-center.gap-3
          - if @apply.resolved_url.present?
            = helpers.link_to I18n.t('apply.manual.open_form'), @apply.resolved_url, \
                target: '_blank', rel: 'noopener noreferrer', \
                class: 'inline-flex items-center justify-center rounded-lg bg-blue-600 ' \
                       'text-white text-sm px-4 py-2 hover:bg-blue-700 font-medium'
          - if bookmarklet
            = helpers.link_to I18n.t('apply.manual.bookmarklet'), bookmarklet, \
                draggable: true, onclick: 'return false', \
                class: 'inline-flex items-center justify-center rounded-lg bg-violet-600 ' \
                       'text-white text-sm px-4 py-2 hover:bg-violet-700 font-medium cursor-move'
          - if @apply.cv.attached?
            = helpers.link_to I18n.t('apply.manual.download_cv'), \
                helpers.rails_blob_path(@apply.cv, disposition: 'attachment'), \
                class: 'inline-flex items-center justify-center rounded-lg border ' \
                       'border-gray-300 dark:border-gray-600 text-sm px-4 py-2 ' \
                       'text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700'
        - if bookmarklet
          .rounded-lg.bg-gray-50.dark:bg-gray-800.p-3.space-y-2(data-controller='clipboard')
            p.text-xs.font-medium.text-gray-700.dark:text-gray-300
              = I18n.t('apply.manual.bookmarklet_hint')
            ol.list-decimal.list-inside.space-y-1.text-xs.text-gray-600.dark:text-gray-400
              li = I18n.t('apply.manual.bookmarklet_step_bar')
              li = I18n.t('apply.manual.bookmarklet_step_drag')
              li = I18n.t('apply.manual.bookmarklet_step_run')
            .flex.items-center.gap-2
              button.rounded-md.border.px-2.py-1.text-xs(
                type='button' data-action='clipboard#copy' data-clipboard-target='button'
                class='border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300')
                = I18n.t('apply.manual.bookmarklet_copy')
              span.text-xs.text-gray-500.dark:text-gray-400
                = I18n.t('apply.manual.bookmarklet_copy_hint')
            .hidden(data-clipboard-target='source') = bookmarklet
        .divide-y.divide-gray-100.dark:divide-gray-700
          - manual_answers.each do |field|
            .flex.items-start.gap-3.py-2(data-controller='clipboard')
              .min-w-0.flex-1
                p.text-xs.font-medium.text-gray-500.dark:text-gray-400
                  = field[:question]
                p.text-sm.text-gray-900.dark:text-gray-100.whitespace-pre-wrap.break-words(
                  data-clipboard-target='source')
                  = field[:answer]
              button.shrink-0.rounded-md.border.px-2.py-1.text-xs(
                type='button' data-action='clipboard#copy' data-clipboard-target='button'
                class='border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300'
                title=I18n.t('apply.manual.copy'))
                = I18n.t('apply.manual.copy')
        - unless @apply.completed?
          .pt-2
            = helpers.button_to I18n.t('apply.manual.submitted'), \
                helpers.confirm_manual_submit_apply_path(@apply), method: :post, \
                class: 'inline-flex items-center justify-center rounded-lg bg-green-600 ' \
                       'text-white text-sm px-4 py-2 hover:bg-green-700 font-medium'

  / Manual answers when automation gave up (needs_review)
  - if @apply.needs_review? && review_fields.any?
    = accordion(title: I18n.t('apply.retry.title'), open: true) do
      .px-6.py-4.space-y-4
        p.text-sm.text-gray-600.dark:text-gray-400 = I18n.t('apply.retry.hint')
        = helpers.form_with url: helpers.retry_apply_path(@apply), method: :post, \
              class: 'space-y-3' do |f|
          - review_fields.each do |field|
            .flex.flex-col.gap-1
              label.text-sm.font-medium.text-gray-700.dark:text-gray-300(for="answer-#{field['fingerprint']}")
                = field['accessible_name'].presence || field['label'].presence || field['name']
              - if field['tag'] == 'textarea'
                textarea.rounded-lg.border.border-gray-300.dark:border-gray-600.dark:bg-gray-800.text-sm.px-3.py-2(
                  id="answer-#{field['fingerprint']}" name="answers[#{field['fingerprint']}]" rows='3')
              - else
                input.rounded-lg.border.border-gray-300.dark:border-gray-600.dark:bg-gray-800.text-sm.px-3.py-2(
                  type='text' id="answer-#{field['fingerprint']}" name="answers[#{field['fingerprint']}]")
          button.inline-flex.items-center.justify-center.rounded-lg.bg-blue-600.text-white.text-sm.px-4.py-2(
            class='hover:bg-blue-700 font-medium transition-colors' type='submit')
            = I18n.t('apply.retry.submit')

  / Error
  - if @apply.error.present?
    = accordion(title: I18n.t('apply.show.fields.error')) do
      .px-6.py-4
        = helpers.tag.p(@apply.error, class: error_text_class)
