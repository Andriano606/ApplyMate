- if @fields.empty?
  p.text-sm.text-gray-400.dark:text-gray-500.italic = I18n.t('apply.card.no_fields')
- else
  / A read-only snapshot of what was sent: controls are readonly/disabled, never submitted.
  .space-y-4
    - @fields.each do |field|
      div
        .mb-1.flex.flex-wrap.items-end.justify-between.gap-x-2.gap-y-1
          p.text-xs.font-medium.text-gray-500.dark:text-gray-400
            = field.display_label
          - answer_path = generate_answer_path(field)
          - if answer_path
            = link(url: answer_path, size: :sm, class: 'gap-1', data: { turbo_stream: true }) do
              = icon(:sparkles, size: 4, class: 'text-indigo-500 dark:text-indigo-400')
              = I18n.t('apply.card.generate_answer')

        - if field.file?
          p(class="#{FIELD_CLASSES} flex items-center gap-2" aria-label=field.display_label)
            = icon(@cv_attached ? :document_text : :x_circle, size: 4, class: 'text-gray-400 dark:text-gray-500')
            = file_label

        - elsif field.textarea?
          textarea(
            rows=6
            readonly=true
            placeholder=field.placeholder
            aria-label=field.display_label
            class=FIELD_CLASSES
          )
            = field.value

        - elsif field.select?
          select(disabled=true aria-label=field.display_label class=FIELD_CLASSES)
            option selected=true = field.value

        - else
          input(
            type='text'
            readonly=true
            value=field.value
            placeholder=field.placeholder
            aria-label=field.display_label
            class=FIELD_CLASSES
          )
