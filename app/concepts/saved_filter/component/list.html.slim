#saved_filters_list
  - if saved_filters.any?
    .max-w-7xl.mx-auto.pb-2
      .flex.items-center.gap-2.flex-wrap.px-1
        - saved_filters.each do |saved_filter|
          span[data-model-id=saved_filter.id class=saved_filter_pill_classes(saved_filter)]
            = helpers.link_to saved_filter.name, apply_saved_filter_path(saved_filter)
            = helpers.link_to icon(:edit, size: 3), helpers.edit_saved_filter_path(saved_filter),
                class: 'flex items-center justify-center w-3 h-3 opacity-50 hover:opacity-100 transition-opacity',
                title: I18n.t('saved_filter.edit.title'),
                data: { turbo_stream: true }
            = helpers.link_to icon(:cross, size: 3), helpers.saved_filter_path(saved_filter),
                class: 'flex items-center justify-center w-3 h-3 opacity-50 hover:opacity-100 transition-opacity',
                'data-turbo-method': :delete,
                'data-turbo-confirm': I18n.t('saved_filter.destroy.confirm')
