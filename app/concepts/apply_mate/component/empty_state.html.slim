.flex.flex-col.items-center.px-4.py-6.text-center
  span.flex.h-12.w-12.items-center.justify-center.rounded-full.bg-gray-100.text-gray-400.dark:bg-gray-700
    = icon(@icon_name, size: 6)
  p.mt-3.text-sm.font-medium.text-gray-900.dark:text-gray-100 = @title
  - if @hint
    p.mt-1.max-w-sm.text-sm.text-gray-500.dark:text-gray-400 = @hint
  - if content?
    .mt-4 = content
