section.mb-6.overflow-hidden.rounded-2xl.bg-gradient-to-br.from-indigo-600.to-violet-600.text-white.shadow-sm[
    data-test-id="guest-banner"]
  .flex.flex-col.gap-6.p-5.sm:p-7.lg:flex-row.lg:items-center.lg:justify-between.lg:gap-10
    .max-w-2xl
      h1.text-xl.font-bold.leading-tight.sm:text-2xl = I18n.t('home.guest_banner.title')
      p.mt-2.text-sm.text-indigo-100.sm:text-base = I18n.t('home.guest_banner.lead', sources:)
      ul.mt-4.grid.gap-2.text-sm.sm:grid-cols-3.sm:gap-4
        - POINTS.each do |icon_name, key|
          li.flex.items-start.gap-2
            span.mt-0.5.shrink-0.text-indigo-200 = icon(icon_name, size: 4)
            span = I18n.t("home.guest_banner.points.#{key}")
    .flex.shrink-0.flex-col.items-stretch.gap-2.sm:items-start.lg:items-stretch
      = helpers.button_to helpers.google_oauth_path, \
          data: { turbo: false, test_id: 'guest-banner-sign-in' }, \
          class: 'inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-white px-5 py-2.5 ' \
                 'text-sm font-semibold text-indigo-700 shadow-sm transition-colors hover:bg-indigo-50' do
        = icon(:google)
        span = I18n.t('home.guest_banner.cta')
      p.text-xs.text-indigo-100.sm:max-w-xs = I18n.t('home.guest_banner.cta_hint')
