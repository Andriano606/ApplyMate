#!/usr/bin/env bash
# Installs curl-impersonate (browser TLS/HTTP2 fingerprints) into vendor/, used by
# ApplyMate::Client::ImpersonateHttp to pass Cloudflare without a browser.
# The binary is arch-specific and NOT committed; run this once per host.
#   bin/install-curl-impersonate
# The default below is THE pin: ApplyMate::Client::ImpersonateHttp::RELEASE reads it from this file
# and the sync compares it with ProxyMate's GET /api/v1/meta release (keep the `:-vX.Y.Z}` form).
# Override the version via CURL_IMPERSONATE_VERSION. Keep it at ProxyMate's version: ProxyMate
# hands out the --impersonate targets (chrome146, firefox147…155) its own build supports.
# Exits non-zero unless the installed binary runs ImpersonateHttp::DEFAULT_IMPERSONATE.
set -euo pipefail

VERSION="${CURL_IMPERSONATE_VERSION:-v2.3.3}"
TARGET="chrome146" # ApplyMate::Client::ImpersonateHttp::DEFAULT_IMPERSONATE
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="$ROOT/vendor/curl-impersonate"

case "$(uname -m)" in
  x86_64)        ARCH="x86_64-linux-gnu" ;;
  aarch64|arm64) ARCH="aarch64-linux-gnu" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

URL="https://github.com/lexiforest/curl-impersonate/releases/download/${VERSION}/curl-impersonate-${VERSION}.${ARCH}.tar.gz"

echo "Downloading curl-impersonate ${VERSION} (${ARCH})…"
mkdir -p "$DEST"
curl -fsSL "$URL" -o "$DEST/ci.tar.gz"
tar xzf "$DEST/ci.tar.gz" -C "$DEST"
rm -f "$DEST/ci.tar.gz"
chmod +x "$DEST/curl-impersonate"

if "$DEST/curl-impersonate" --impersonate "$TARGET" --compressed -s -o /dev/null file:///dev/null; then
  echo "OK — installed to $DEST (curl-impersonate --impersonate $TARGET runnable)"
else
  echo "ERROR — $DEST/curl-impersonate cannot run --impersonate $TARGET on this host" >&2
  exit 1
fi
