#!/usr/bin/env bash
# Installs curl-impersonate (Chrome TLS/HTTP2 fingerprint) into vendor/, used by
# ApplyMate::Client::ImpersonateHttp to pass Cloudflare without a browser.
# The binary is arch-specific and NOT committed; run this once per host.
#   bin/install-curl-impersonate
#
# Environment:
#   CURL_IMPERSONATE_VERSION  release tag to download (default v1.5.6)
#   CURL_IMPERSONATE_DEST     install directory (default <repo>/vendor/curl-impersonate);
#                             lets the artifact check run outside vendor/ (spec/bin)
#   CURL_IMPERSONATE_BIN      read by ApplyMate::Client::ImpersonateHttp, not by this
#                             script: points the client at a wrapper already on the host
#
# Fails loudly: exits non-zero when the download fails, the archive lacks
# curl_chrome136, or curl_chrome136 is not runnable on this host. The Dockerfile's
# `RUN bin/install-curl-impersonate` therefore stops the image build instead of
# shipping an image whose Dou scraper breaks at runtime. The archive is verified in
# a staging dir first, so a failed run never overwrites a working install.
set -euo pipefail

VERSION="${CURL_IMPERSONATE_VERSION:-v1.5.6}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${CURL_IMPERSONATE_DEST:-$ROOT/vendor/curl-impersonate}"

case "$(uname -m)" in
  x86_64)        ARCH="x86_64-linux-gnu" ;;
  aarch64|arm64) ARCH="aarch64-linux-gnu" ;;
  *) echo "ERROR: unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

URL="https://github.com/lexiforest/curl-impersonate/releases/download/${VERSION}/curl-impersonate-${VERSION}.${ARCH}.tar.gz"

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

echo "Downloading curl-impersonate ${VERSION} (${ARCH})…"
curl -fsSL "$URL" -o "$STAGE/ci.tar.gz"
tar xzf "$STAGE/ci.tar.gz" -C "$STAGE"
rm -f "$STAGE/ci.tar.gz"

[ -f "$STAGE/curl_chrome136" ] || {
  echo "ERROR: curl_chrome136 missing after extracting $URL" >&2
  exit 1
}

for f in "$STAGE/curl-impersonate" "$STAGE"/curl_chrome*; do
  if [ -f "$f" ]; then chmod +x "$f"; fi
done

"$STAGE/curl_chrome136" --version >/dev/null 2>&1 || {
  echo "ERROR: curl_chrome136 is not runnable on this host ($(uname -m))" >&2
  exit 1
}

mkdir -p "$DEST"
cp -a "$STAGE"/. "$DEST"/
echo "OK — installed to $DEST (curl_chrome136 runnable)"
